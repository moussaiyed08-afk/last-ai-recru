# Copiez ce fichier en ".env" et remplissez les valeurs
# Connexion Base de Données (PostgreSQL en local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recrutement"

# Clé secrète pour l'authentification JWT (générée aléatoirement et sécurisée)
JWT_SECRET="a8f9c2e4b7d1f6a3c9e8b2d5f7a4c1e9b6d3f8a2c5e7b4d1f6a9c3e2b5d8f1a4"

# Port du serveur Backend
PORT=5000

# Score IA (Groq) - À renseigner si tu intègres l'évaluation IA
GROQ_API_KEY=""

# Emails de notification (Gmail : utilise ton adresse et un mot de passe d'application)
EMAIL_USER=""
EMAIL_PASS=""
